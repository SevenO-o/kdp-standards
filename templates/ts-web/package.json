{
  "name": "kdp-ts-web-tool",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "contracts": "tsx scripts/generate-contracts.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build": "npm run contracts && npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "check": "npm run contracts && npm run typecheck",
    "start": "node dist/server/index.js",
    "preview:platform": "tsx scripts/preview-platform.ts",
    "verify:platform": "tsx scripts/verify-platform.ts"
  },
  "dependencies": {
    "@fastify/static": "10.1.3",
    "@fastify/swagger": "9.8.1",
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tabs": "1.1.21",
    "@sinclair/typebox": "0.34.52",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fastify": "5.12.3",
    "lucide-react": "1.43.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  }
}
